    <string name="int_app_role">The Mac app: chat, tasks, memory, control</string>
    <string name="int_app_how">Already connected: the app talks to the server with the APP_TOKEN password.</string>
    <string name="int_phone_name">Phone</string>
    <string name="int_phone_role">This Android app: chat, talking by voice, tasks, memory, rules</string>
    <string name="int_phone_how">The Mac address and the APP_TOKEN password are entered on the connection screen.</string>
    <string name="int_hearing_name">Hearing</string>
    <string name="int_hearing_role">Background hearing on the Mac: speech around it becomes text right there; \"Sena, …\" is a command, the rest is talk to sort out</string>
    <string name="int_hearing_how">One command on the Mac installs the models and programs: python -m sena.home setup (whisper.cpp and ffmpeg come from brew).</string>
    <string name="int_browser_name">Chrome</string>
    <string name="int_browser_role">Websites: read, click, fill in, buy</string>
    <string name="int_browser_how">Nothing to set up: Chrome opens by itself on the first browser task.</string>
    <string name="int_mac_name">Mac terminal</string>
    <string name="int_mac_role">Files, programs and screenshots of this Mac</string>
    <string name="int_mac_how">Already connected: the agent works right on the Mac.</string>
    <string name="int_claude_name">Claude Code</string>
    <string name="int_claude_role">Project code and Sena\'s self-improvement, via subscription</string>
    <string name="int_claude_how">Works through a Claude subscription in the terminal; the API is not used. Sign in with claude login.</string>
    <string name="int_google_name">Google</string>
    <string name="int_google_role">Mail, Sheets, Drive</string>
    <string name="int_google_how">Needs the google_client.json file from Google Cloud; sign in once in a browser.</string>
    <string name="int_github_name">GitHub</string>
    <string name="int_github_role">Repositories, issues, pull requests, releases; changes only after your yes</string>
    <string name="int_github_how">A token for the needed repositories goes into .env as SENA_GITHUB_TOKEN.</string>
    <string name="int_hireflow_name">Hire-flow</string>
    <string name="int_hireflow_role">Job search on hh.ru, vacancy scoring, letters; letters stay drafts</string>
    <string name="int_hireflow_how">A key from the Hire-flow project goes into .env as HIREFLOW_KEY, the server address as HIREFLOW_URL.</string>
    <string name="int_site_name">Portfolio site</string>
    <string name="int_site_role">Texts, works, links and visit statistics of your site</string>
    <string name="int_site_how">The site key SENA_SITE_KEY and the address SITE_URL go into Sena\'s .env.</string>
    <string name="int_youtube_name">YouTube</string>
    <string name="int_youtube_role">Your channel: videos, playlists, comments, statistics; publishing only after your yes</string>
    <string name="int_youtube_how">The same Google sign-in: grant YouTube access and enable the YouTube Data API v3.</string>
    <string name="int_luma_name">Luma</string>
    <string name="int_luma_role">Your tasks, calendar, habits, spending and notes</string>
    <string name="int_luma_how">Nothing to enter: Sena opens the Luma app herself if it is closed.</string>
    <string name="int_mcp_name">MCP servers</string>
    <string name="int_mcp_role">Tools you connected: only after your \"allow\", in a sandbox</string>
    <string name="int_mcp_how">A server is added under More → MCP servers or in the Mac app; it runs in a macOS sandbox without Sena\'s keys, only after your \"allow\".</string>
    <string name="int_sources_name">Open sources</string>
    <string name="int_sources_role">Weather, rates, news, surf forecast — no keys needed</string>
    <string name="int_sources_how">Nothing to set up.</string>
    <string name="int_maps_name">Maps</string>
    <string name="int_maps_role">TomTom for traffic and routes, Google Maps for places and opening hours</string>
    <string name="int_maps_how">The keys TOMTOM_KEY and GOOGLE_MAPS_KEY go into .env; either one is enough.</string>
    <string name="int_travel_name">Flights (Aviasales)</string>
    <string name="int_travel_role">Cheap flights by route and month, price alerts</string>
    <string name="int_travel_how">A Travelpayouts token goes into .env as TRAVELPAYOUTS_TOKEN.</string>
    <string name="int_gemini_name">Gemini</string>
    <string name="int_gemini_role">Sena\'s voice everywhere (Kore), the live conversation, transcription when the home hearing fails, pictures and videos from a description</string>
    <string name="int_gemini_how">A key from Google AI Studio goes into .env as GEMINI_API_KEY.</string>
    <string name="int_scheduler_name">Scheduler</string>
    <string name="int_scheduler_role">Runs your jobs, background checks, price alerts, cleanup and review</string>
    <string name="int_scheduler_how">Runs inside Sena; what and how often is in the Rules section.</string>
    <string name="int_memory_name">Memory</string>
    <string name="int_memory_role">Core memory, archive, people, skills, rules, chat; search by meaning</string>
    <string name="int_memory_how">Records in one database on the Mac; search fingerprints are made by the home model on this Mac.</string>
    <string name="int_obsidian_name">Obsidian</string>
    <string name="int_obsidian_role">A notes vault: people, memory, skills and the task diary become notes</string>
    <string name="int_obsidian_how">The Obsidian_sena folder on the Mac; open it as a vault in Obsidian.</string>
    <string name="int_claude_api_name">Claude</string>
    <string name="int_claude_api_role">Sena\'s brain: the coordinator, voice commands, the browser and computer agents, task reviews, night cleanup, personality</string>
    <string name="int_claude_api_how">A key from the Anthropic Console goes into .env as SENA_CLAUDE_BRAIN_KEY; the helpers\' key SENA_CLAUDE_AGENTS_KEY is optional, without it they use the brain\'s key.</string>
    <string name="int_openai_name">OpenAI</string>
    <string name="int_openai_role">A spare: not used now — Claude thinks, memory fingerprints are made at home</string>
    <string name="int_openai_how">A key from platform.openai.com goes into .env as OPENAI_API_KEY. Needed only to move memory fingerprints to the cloud (Analytics → Home and cloud).</string>
