    <string name="int_telegram_bot_name">Telegram bot</string>
    <string name="int_telegram_bot_role">A chat channel: messages, voice, photos, files</string>
    <string name="int_telegram_bot_how">A bot token from @BotFather goes into .env as TELEGRAM_TOKEN, your Telegram id as TG_OWNER_ID.</string>
