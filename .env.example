# Скопируй в .env и впиши свои значения. Файл .env в git не попадает.
TELEGRAM_TOKEN=          # токен Телеграм-бота от @BotFather
TG_OWNER_ID=             # твой числовой id в Телеграме: бот отвечает только тебе
TG_API_ID=               # my.telegram.org: доступ к твоему аккаунту (чтение чатов)
TG_API_HASH=
OPENAI_API_KEY=          # необязательно: сейчас не нужен (всё на Claude и Gemini); только если вернуть модель OpenAI
APP_TOKEN=               # любой длинный пароль: им защищён сервер для приложения на телефоне
GEMINI_API_KEY=          # ключ из aistudio.google.com/apikey: голос Сены (Kore), запасной слух, картинки и видео (платный тариф). Без него Сена говорит домашним голосом
TOMTOM_KEY=              # необязательно: ключ с developer.tomtom.com (бесплатно, без карты): места и маршруты
TRAVELPAYOUTS_TOKEN=     # необязательно: travelpayouts.com → Профиль → API token (бесплатно): дешёвые билеты и сигналы по цене
GOOGLE_MAPS_KEY=         # необязательно: обычный API-ключ из Google Cloud → Credentials (не ключ Gemini AQ...); в проекте включить Places API (New) и Routes API, нужен платёжный аккаунт
LUMA_URL=                # необязательно: адрес программы Luma на этом Mac, по умолчанию http://127.0.0.1:3110 (чужие адреса Сена не берёт)
LUMA_KEY=                # необязательно: ключ API Luma (Luma → Настройки → Панель разработчика → Ключи, права «чтение и запись»): в журнале Luma действия видны под именем ключа, работают её выключатели
LUMA_APP=                # необязательно: путь к Luma.app, чтобы Сена открывала её сама; по умолчанию ~/Desktop/Luma/desktop/dist/mac-arm64/Luma.app
# Ключи Claude API для самой Сены (не для кода: код пишется только по подписке). Имя в Anthropic Console = имя переменной строчными буквами через дефис.
# Они не попадают в окружение терминала и Claude Code. Назвать ANTHROPIC_API_KEY нельзя.
SENA_CLAUDE_BRAIN_KEY=   # Console: sena-brain — основной мозг (MODEL_MAIN): координатор, ночная уборка, недельный разбор, личность. Обязателен
SENA_CLAUDE_AGENTS_KEY=  # Console: sena-agents — помощники: браузер, компьютер, разбор задач, мелкие дела (Haiku), голосовые команды (Sonnet). Без него — по ключу мозга
SITE_URL=                # необязательно: адрес сайта-портфолио, https://… (тексты, ссылки для откликов, статистика)
SITE_PUBLIC_URL=         # необязательно: публичный адрес сайта, который Сена проверяет («открывается ли»); пусто или off — не проверять
SENA_SITE_KEY=           # необязательно: ключ закрытого API сайта (тот же, что SENA_SITE_KEY в окружении самого сайта)
# GitHub: github.com -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens -> Generate. Repository access: только нужные репозитории.
# Если GitHub не сохраняет выбор репозиториев, подойдёт классический токен (Tokens (classic)) с правами repo, workflow, gist, notifications.
# Права: Metadata (read), Issues (read and write), Pull requests (read and write), Contents (read), Actions (read and write, если нужен запуск). Срок 90 дней. Код правит ag_code, а не токен.
SENA_GITHUB_TOKEN=       # необязательно: токен GitHub (github_pat_...)
# OpenAlex: openalex.org/settings/api (бесплатно, нужна почта). Без ключа научный поиск работает, но дневной бюджет общий на адрес; когда он кончится, Сена берёт Crossref
OPENALEX_KEY=            # необязательно
# SEC EDGAR требует в каждом запросе имя и почту того, кто спрашивает: SEC_CONTACT="Имя Фамилия почта@пример.com". Без неё отчёты компаний США не открываются
SEC_CONTACT=             # необязательно
# Hire-flow (поиск работы, письма): адрес сервера и ключ API. Ключ выпускается в папке Hire-flow: python -m app.cli api-key create --email <почта> --name sena
HIREFLOW_URL=            # необязательно: http://127.0.0.1:8000 (этот Mac) или https://…
HIREFLOW_KEY=            # необязательно: hf_…
